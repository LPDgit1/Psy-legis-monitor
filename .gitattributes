# Normalize text in the repository while keeping platform-specific scripts usable.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
Dockerfile text eol=lf

*.cfg text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

*.cmd text eol=crlf
